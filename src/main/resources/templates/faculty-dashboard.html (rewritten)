<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" lang="en">
<head>
    <meta charset="UTF-8">
    <title>Faculty Dashboard</title>
    <style>
        body{font-family:Arial,sans-serif;background:#f5f7fb;padding:24px;}
        .wrap{max-width:1100px;margin:0 auto;}
        h1{color:#1f2937;margin-bottom:12px;}
        .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:18px;}
        .tile{background:#fff;border-radius:12px;box-shadow:0 8px 18px rgba(0,0,0,0.06);padding:14px 16px;}
        .tile strong{display:block;font-size:28px;color:#111;margin-top:6px;}
        table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 8px 18px rgba(0,0,0,0.06);margin-top:10px;}
        th,td{padding:10px 12px;border-bottom:1px solid #e5e7eb;text-align:left;font-size:14px;}
        th{background:#f0f2f7;color:#475569;text-transform:uppercase;font-size:12px;}
        .badge{padding:5px 10px;border-radius:999px;font-weight:700;font-size:12px;display:inline-block;}
        .approved{background:#dcfce7;color:#166534;}
        .draft{background:#eef2ff;color:#4338ca;}
        .btn{display:inline-block;padding:10px 14px;border:none;border-radius:8px;font-weight:700;text-decoration:none;cursor:pointer;}
        .primary{background:#4f46e5;color:#fff;}
        textarea,input,select{width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px;}
        .card{background:#fff;border-radius:12px;box-shadow:0 8px 18px rgba(0,0,0,0.06);padding:16px;margin-top:14px;}
    </style>
</head>
<body>
<div class="wrap">
    <h1>Faculty Dashboard</h1>

    <div class="grid">
        <div class="tile">
            <span>Lectures scheduled</span>
            <strong th:text="${personalTimetable.size()}">0</strong>
        </div>
        <div class="tile">
            <span>Today's lectures</span>
            <strong th:text="${todayLectures.size()}">0</strong>
        </div>
    </div>

    <a class="btn primary" href="/faculty-timetable">View Full Timetable</a>

    <div class="card" style="margin-top:18px;">
        <h3>Today's Lectures</h3>
        <table>
            <thead><tr><th>Time</th><th>Subject</th><th>Room</th><th>Status</th></tr></thead>
            <tbody>
                <tr th:each="t : ${todayLectures}">
                    <td th:text="${t.timeSlot}">09:00 - 10:00</td>
                    <td th:text="${t.subject}">Java</td>
                    <td th:text="${t.room}">A101</td>
                    <td><span class="badge" th:classappend="${t.status}=='Approved' ? ' approved' : ' draft'" th:text="${t.status}">Draft</span></td>
                </tr>
                <tr th:if="${#lists.isEmpty(todayLectures)}"><td colspan="4" style="text-align:center;color:#6b7280;">No lectures today.</td></tr>
            </tbody>
        </table>
    </div>

    <div class="card">
        <h3>Lecture Status</h3>
        <form action="/faculty-lecture/status" method="post" style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;">
            <select name="id" required>
                <option value="">Select lecture</option>
                <option th:each="t : ${personalTimetable}" th:value="${t.id}"
                        th:text="${t.day + ' | ' + t.timeSlot + ' | ' + t.subject + ' | ' + t.className}"></option>
            </select>
            <select name="status" required>
                <option value="Approved">Completed</option>
                <option value="Cancelled">Cancelled</option>
                <option value="Rescheduled">Rescheduled</option>
            </select>
            <button class="btn primary" type="submit">Update</button>
        </form>
    </div>

    <div class="card">
        <h3>Request Change</h3>
        <form action="/faculty-request-change" method="post" style="display:grid;grid-template-columns:1fr;gap:8px;">
            <label>Select lecture (optional)</label>
            <select name="timetableId">
                <option value="">None</option>
                <option th:each="t : ${personalTimetable}" th:value="${t.id}"
                        th:text="${t.day + ' | ' + t.timeSlot + ' | ' + t.subject + ' | ' + t.className}"></option>
            </select>
            <label>Details</label>
            <textarea name="message" rows="3" placeholder="Describe the change needed" required></textarea>
            <button class="btn primary" type="submit">Send Request</button>
        </form>
    </div>
</div>
</body>
</html>
